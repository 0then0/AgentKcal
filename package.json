{
  "name": "agentkcal",
  "version": "0.1.0",
  "description": "Local AI agent usage accounting, energy scenarios and food equivalents",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0then0/AgentKcal.git"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "agentkcal": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "LICENSE",
    "README.md",
    "integrations",
    "README.ru.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.web.json && node scripts/assets.ts",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --test tests/*.test.ts",
    "start": "node dist/cli.js",
    "demo": "node dist/cli.js demo",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test:package": "node scripts/package-smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "homepage": "https://github.com/0then0/AgentKcal#readme",
  "bugs": {
    "url": "https://github.com/0then0/AgentKcal/issues"
  },
  "keywords": [
    "ai-agents",
    "usage-tracking",
    "energy",
    "tokens",
    "local-first",
    "mcp",
    "cli",
    "dashboard"
  ]
}
